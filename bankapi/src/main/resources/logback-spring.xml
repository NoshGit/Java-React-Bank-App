<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Spring profiles: dev, prod -->
    <springProfile name="dev,default">
        <property name="LOG_LEVEL" value="DEBUG"/>
        <property name="LOG_DIR" value="logs/dev"/>
    </springProfile>
    <springProfile name="prod">
        <property name="LOG_LEVEL" value="INFO"/>
        <property name="LOG_DIR" value="logs/prod"/>
    </springProfile>

    <!-- Default LOG_DIR if not set by profile -->
    <property name="LOG_DIR" value="logs" scope="context"/>

    <!-- CONSOLE APPENDER - Colored output for console -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <!-- Colored pattern for console -->
            <pattern>
                %d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %highlight(%-5level) %cyan(%logger{36}) - %msg%n
            </pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- FILE APPENDER - Rolling file with size-based rotation -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/application.log</file>
        <append>true</append>
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>
                %d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n
            </pattern>
            <charset>UTF-8</charset>
        </encoder>

        <!-- Rolling policy: rotate by size and date -->
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>
                ${LOG_DIR}/application-%d{yyyy-MM-dd}.%i.log.gz
            </fileNamePattern>
            <!-- Max size before rotation -->
            <maxFileSize>10MB</maxFileSize>
            <!-- Keep logs for 30 days -->
            <maxHistory>30</maxHistory>
            <!-- Max total size of all log files -->
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- JSON APPENDER - Structured logging for ELK/monitoring -->
    <appender name="JSON_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/application-json.log</file>
        <append>true</append>
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <timeZone>UTC</timeZone>
            <includeContext>true</includeContext>
            <customFields>{"application":"bankapi","environment":"${spring.profiles.active}"}</customFields>
        </encoder>

        <!-- Rolling policy: rotate by date -->
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>
                ${LOG_DIR}/application-json-%d{yyyy-MM-dd}.%i.log.gz
            </fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- ERROR FILE APPENDER - Separate error logs -->
    <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/error.log</file>
        <append>true</append>
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>ERROR</level>
            <onMatch>ACCEPT</onMatch>
            <onMismatch>DENY</onMismatch>
        </filter>
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>
                %d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n
            </pattern>
            <charset>UTF-8</charset>
        </encoder>

        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>
                ${LOG_DIR}/error-%d{yyyy-MM-dd}.%i.log.gz
            </fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>500MB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- ASYNC APPENDER - Non-blocking logging for performance -->
    <appender name="ASYNC_FILE" class="ch.qos.logback.classic.AsyncAppender">
        <appender-ref ref="FILE"/>
        <!-- Queue capacity -->
        <queueSize>512</queueSize>
        <!-- Discard TRACE level when queue is full -->
        <discardingThreshold>0</discardingThreshold>
        <!-- Don't block when queue is full -->
        <includeCallerData>false</includeCallerData>
    </appender>

    <!-- ASYNC JSON APPENDER -->
    <appender name="ASYNC_JSON_FILE" class="ch.qos.logback.classic.AsyncAppender">
        <appender-ref ref="JSON_FILE"/>
        <queueSize>512</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <includeCallerData>false</includeCallerData>
    </appender>

    <!-- ASYNC ERROR APPENDER -->
    <appender name="ASYNC_ERROR_FILE" class="ch.qos.logback.classic.AsyncAppender">
        <appender-ref ref="ERROR_FILE"/>
        <queueSize>256</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <includeCallerData>true</includeCallerData>
    </appender>

    <!-- LOGGER CONFIGURATION - Log levels per package -->
    <!-- Application package - DEBUG level -->
    <logger name="com.example" level="DEBUG"/>
    <logger name="com.example.bankapi" level="DEBUG"/>

    <!-- Service layer - DEBUG -->
    <logger name="com.example.service" level="DEBUG"/>

    <!-- Controller layer - DEBUG -->
    <logger name="com.example.controller" level="DEBUG"/>

    <!-- Spring Framework - INFO level -->
    <logger name="org.springframework" level="INFO"/>
    <logger name="org.springframework.security" level="DEBUG"/>
    <logger name="org.springframework.web" level="INFO"/>

    <!-- ROOT LOGGER - Default configuration -->
    <root level="${LOG_LEVEL}">
        <!-- Console appender for development -->
        <appender-ref ref="CONSOLE"/>
        <!-- Async file appenders for performance -->
        <appender-ref ref="ASYNC_FILE"/>
        <appender-ref ref="ASYNC_JSON_FILE"/>
        <appender-ref ref="ASYNC_ERROR_FILE"/>
    </root>

</configuration>
